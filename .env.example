# Voice-rmv local development configuration
# All values shown are safe defaults for local use only.
# Override via environment variables or a local .env file (not committed).

DATABASE_URL=postgresql+asyncpg://voice_rmv:voice_rmv_dev@localhost:5432/voice_rmv
REDIS_URL=redis://localhost:6379/0
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Database password (default used in docker-compose.yml)
POSTGRES_PASSWORD=voice_rmv_dev

# Translation controller token (placeholder for local development)
TRANSLATION_CONTROLLER_TOKEN=voice-rmv-local-controller
